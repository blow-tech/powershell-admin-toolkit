<# Read-only CIM volume evidence. Requires CIM read permissions on explicit target.
Capacity values are numeric bytes; unavailable/invalid data stops collection. No WMI v1 or formatting strings. #>
[CmdletBinding()]
param([Parameter(Mandatory)][string]$ComputerName)
$ErrorActionPreference='Stop'
$volumes=@(Get-CimInstance -ClassName Win32_Volume -ComputerName $ComputerName -OperationTimeoutSec 30 -ErrorAction Stop | Where-Object {$_.DriveType -in 2,3})
if(-not $volumes.Count){throw 'UNKNOWN: no volume observations returned.'}
$rows=@(foreach($v in $volumes){
 if($null -eq $v.Capacity -or $v.Capacity -le 0 -or $null -eq $v.FreeSpace -or $v.FreeSpace -lt 0 -or $v.FreeSpace -gt $v.Capacity){throw 'UNKNOWN: invalid volume capacity/free-space data.'}
 [pscustomobject]@{ComputerName=$ComputerName;Name=$v.Name;CapacityBytes=$v.Capacity;FreeBytes=$v.FreeSpace;FreePercent=[math]::Round(100*$v.FreeSpace/$v.Capacity,2)}
})
$rows | Sort-Object FreePercent
