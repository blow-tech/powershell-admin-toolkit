#Requires -Version 5.1
<#
.SYNOPSIS
Preview cloud-only managed-domain password-expiry notifications.
.DESCRIPTION
Requires an existing Graph session in the explicit tenant. Never installs modules,
creates schedules, guesses missing policy, or disconnects an existing session.
Federated, synchronized, guest and unknown-policy users are not eligible.
-Send requires approved mail scope, explicit sender and protected state directory.
Pending markers deliberately suppress automatic retries after ambiguous mail failures.
Original entry point: AdminDroid Community / o365reports.com.
#>
[CmdletBinding(SupportsShouldProcess,ConfirmImpact='High')]
param(
    [Parameter(Mandatory)][guid]$TenantId,
    [Parameter(Mandatory)][ValidateRange(1,365)][int]$DaysToExpiry,
    [switch]$LicensedUsersOnly,
    [switch]$Send,
    [string]$FromAddress,
    [string]$StateDirectory
)
$ErrorActionPreference='Stop'
function Get-CloudPasswordExpiryPlan {
    param($User,[hashtable]$Domains,[datetimeoffset]$Now,[int]$DaysToExpiry,[switch]$LicensedUsersOnly)
    $result=[ordered]@{UserId=$User.Id;UserPrincipalName=$User.UserPrincipalName;Recipient=$User.Mail
        Status='Excluded';Reason=$null;ExpiryUtc=$null;DaysToExpiry=$null}
    if ($User.AccountEnabled -ne $true -or $User.UserType -ne 'Member') {$result.Reason='Disabled or non-member'}
    elseif ($User.OnPremisesSyncEnabled -eq $true) {$result.Reason='Synchronized policy requires separate validation'}
    elseif (([string]$User.PasswordPolicies -split '\s*,\s*') -contains 'DisablePasswordExpiration') {$result.Reason='Password expiration disabled'}
    elseif ($LicensedUsersOnly -and @($User.AssignedLicenses).Count -eq 0) {$result.Reason='Unlicensed'}
    else {
        $parts=([string]$User.UserPrincipalName).Split('@')
        $domain=if ($parts.Count -eq 2) {$Domains[$parts[1]]} else {$null}
        $age=0
        if ($null -eq $domain -or -not [int]::TryParse([string]$domain.PasswordValidityPeriodInDays,[ref]$age) -or $age -le 0) {
            $result.Status='UNKNOWN';$result.Reason='Missing/invalid authoritative domain policy'
        } elseif ($domain.AuthenticationType -ne 'Managed') {$result.Reason='Not a managed domain'}
        elseif ($age -eq [int]::MaxValue) {$result.Reason='Domain password expiration disabled'}
        elseif ($null -eq $User.LastPasswordChangeDateTime) {$result.Status='UNKNOWN';$result.Reason='Missing password change time'}
        else {
            try {
                $changed=[datetimeoffset]$User.LastPasswordChangeDateTime
                if ($changed -gt $Now) {throw 'Future password-change time'}
                $expiry=$changed.AddDays($age)
                $result.ExpiryUtc=$expiry.ToUniversalTime().ToString('o')
                $result.DaysToExpiry=[math]::Ceiling(($expiry-$Now).TotalDays)
                if ($expiry -le $Now) {$result.Reason='Already expired'}
                elseif ($expiry -gt $Now.AddDays($DaysToExpiry)) {$result.Reason='Outside notification window'}
                else {
                    $id=[guid]::Empty
                    if (-not [guid]::TryParse([string]$User.Id,[ref]$id)) {throw 'Invalid immutable user ID'}
                    if ([string]::IsNullOrWhiteSpace($User.Mail)) {throw 'No directory mail address'}
                    $address=New-Object Net.Mail.MailAddress([string]$User.Mail)
                    if ($address.Address -ne $User.Mail) {throw 'Directory mail is not a bare address'}
                    $result.Status='Eligible';$result.Reason='Cloud-only policy observation; tenant lab validation required'
                }
            } catch {$result.Status='UNKNOWN';$result.Reason=$_.Exception.Message}
        }
    }
    [pscustomobject]$result
}
$context=Get-MgContext -ErrorAction Stop
if ($null -eq $context -or $context.TenantId -ne $TenantId.ToString()) {throw 'Connect separately to the expected tenant.'}
if ($Send) {
    if (-not $FromAddress -or -not $StateDirectory) {throw 'Send requires explicit FromAddress and protected StateDirectory.'}
    $null=New-Object Net.Mail.MailAddress($FromAddress)
    $state=Get-Item -LiteralPath $StateDirectory -Force -ErrorAction Stop
    if (-not $state.PSIsContainer -or $state.PSProvider.Name -ne 'FileSystem') {throw 'Existing protected state directory required.'}
    for ($a=$state;$null -ne $a;$a=$a.Parent) {
        if ($a.Attributes -band [IO.FileAttributes]::ReparsePoint) {throw 'Reparse state paths are unsupported.'}
    }
}
$domains=@{}
foreach ($domain in (Get-MgDomain -All -ErrorAction Stop)) {$domains[$domain.Id]=$domain}
$now=[datetimeoffset]::UtcNow
$properties=@('Id','Mail','UserPrincipalName','AccountEnabled','UserType','OnPremisesSyncEnabled','AssignedLicenses','PasswordPolicies','LastPasswordChangeDateTime')
$plan=@(Get-MgUser -All -Filter 'accountEnabled eq true' -Property $properties -ErrorAction Stop | ForEach-Object {
    Get-CloudPasswordExpiryPlan $_ $domains $now $DaysToExpiry -LicensedUsersOnly:$LicensedUsersOnly
})
# Complete all discovery before sending anything; a failed collection throws.
foreach ($notice in $plan) {
    if ($Send -and $notice.Status -eq 'Eligible' -and $PSCmdlet.ShouldProcess($notice.Recipient,"Send password-expiry notice from $FromAddress")) {
        $key="$TenantId-$($notice.UserId)-$($now.ToString('yyyyMMdd')).state"
        $marker=Join-Path $state.FullName $key
        # CreateNew atomically claims the daily notification across concurrent runs.
        try {$stream=[IO.File]::Open($marker,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)}
        catch [IO.IOException] {
            if (Test-Path -LiteralPath $marker) {$notice.Status='Suppressed';$notice.Reason='Prior completed/pending marker; reconcile before retry';$notice;continue}
            throw
        }
        try {
            $pending=[Text.Encoding]::UTF8.GetBytes('PENDING - mail result may be unknown; do not retry without reconciliation.')
            $stream.Write($pending,0,$pending.Length);$stream.Flush($true)
            $body=@{message=@{subject='Password expiry notification';body=@{contentType='Text';content="Your password is expected to expire at $($notice.ExpiryUtc). Contact your help desk if this differs from your policy."};toRecipients=@(@{emailAddress=@{address=$notice.Recipient}})}}
            Send-MgUserMail -UserId $FromAddress -BodyParameter $body -ErrorAction Stop
            $stream.Position=0;$stream.SetLength(0)
            $sent=[Text.Encoding]::UTF8.GetBytes('ACCEPTED by Graph - delivery not independently verified.')
            $stream.Write($sent,0,$sent.Length);$stream.Flush($true)
            $notice.Status='Accepted'
        } finally {$stream.Dispose()}
    }
    $notice
}
