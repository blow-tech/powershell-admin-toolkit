#Requires -Version 5.1
<#
.SYNOPSIS
 Comprehensive Windows/AD environment health check with HTML report output.

.DESCRIPTION
 Performs automated health checks across Active Directory, DNS, Disk, Services,
 Certificates, and AD Replication. Outputs a timestamped HTML report and optional
 email delivery via Send-MailMessage or Exchange Online.

 Checks performed:
 - Active Directory replication status (repadmin)
 - DNS resolution and forwarder health
 - Disk space on all fixed drives (configurable threshold)
 - Critical Windows services state
 - Certificate expiry (Local Machine store)
 - Sysvol / Netlogon share availability
 - Domain Controller connectivity (ping + LDAP port)
 - Last AD backup metadata timestamp
 - Event log error summary (System + Application, last 24h)

.PARAMETER OutputPath
 Directory where the HTML report is saved. Defaults to the script root.

.PARAMETER DiskThresholdPercent
 Disk free % below which a drive is flagged as WARNING. Default: 20.

.PARAMETER CertWarningDays
 Days before certificate expiry to flag as WARNING. Default: 60.

.PARAMETER CriticalDays
 Days before certificate expiry to flag as CRITICAL. Default: 30.

.PARAMETER SendEmail
 If specified, emails the report using the parameters below.

.PARAMETER SmtpServer
 SMTP relay server for email delivery.

.PARAMETER EmailFrom
 Sender address.

.PARAMETER EmailTo
 One or more recipient addresses.

.PARAMETER Services
 Array of service names to check. Defaults to a standard critical-service list.

.EXAMPLE
 .\Get-EnvironmentHealthCheck.ps1
 Runs all checks and saves an HTML report to the script directory.

.EXAMPLE
 .\Get-EnvironmentHealthCheck.ps1 -DiskThresholdPercent 15 -CertWarningDays 45 -OutputPath "C:\Reports"

.EXAMPLE
 .\Get-EnvironmentHealthCheck.ps1 -SendEmail -SmtpServer "smtp.domain.local" -EmailFrom "healthcheck@domain.local" -EmailTo "it-team@domain.local"

.NOTES
 Author : blow-tech
 Version : 1.0.0
 Requires : ActiveDirectory module, DNS Server Tools (optional), Run as Administrator
 Tested on : Windows Server 2016, 2019, 2022
 GitHub : https://github.com/blow-tech/powershell-admin-toolkit
#>

[CmdletBinding()]
param (
 [string] $OutputPath = $PSScriptRoot,
 [int] $DiskThresholdPercent = 20,
 [int] $CertWarningDays = 60,
 [int] $CertCriticalDays = 30,
 [switch] $SendEmail,
 [string] $SmtpServer,
 [string] $EmailFrom,
 [string[]] $EmailTo,
 [string[]] $Services = @(
 'ADWS','DNS','DFS','DFSR','kdc','LanmanServer',
 'LanmanWorkstation','Netlogon','NTDS','W32Time','WinRM'
 )
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

#region ── Helpers ────────────────────────────────────────────────────────────

function Write-Log {
 param([string]$Message, [string]$Level = 'INFO')
 $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
 $color = switch ($Level) {
 'WARN' { 'Yellow' }
 'ERROR' { 'Red' }
 'OK' { 'Green' }
 default { 'Cyan' }
 }
 Write-Host "[$ts][$Level] $Message" -ForegroundColor $color
}

function New-CheckResult {
 param(
 [string] $Category,
 [string] $Item,
 [string] $Status, # OK | WARNING | CRITICAL | INFO
 [string] $Detail
 )
 [PSCustomObject]@{
 Category = $Category
 Item = $Item
 Status = $Status
 Detail = $Detail
 }
}

#endregion

#region ── Check Functions ────────────────────────────────────────────────────

function Get-DiskHealthChecks {
 Write-Log "Checking disk space..."
 $drives = Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Used -ne $null }
 foreach ($d in $drives) {
 $total = $d.Used + $d.Free
 if ($total -eq 0) { continue }
 $freePct = [math]::Round(($d.Free / $total) * 100, 1)
 $freeGB = [math]::Round($d.Free / 1GB, 1)
 $totalGB = [math]::Round($total / 1GB, 1)
 $status = if ($freePct -lt ($DiskThresholdPercent / 2)) { 'CRITICAL' }
 elseif ($freePct -lt $DiskThresholdPercent) { 'WARNING' }
 else { 'OK' }
 New-CheckResult -Category 'Disk' -Item "$($d.Name):\" `
 -Status $status -Detail "$freeGB GB free of $totalGB GB ($freePct% free)"
 }
}

function Get-ServiceHealthChecks {
 Write-Log "Checking critical services..."
 foreach ($svc in $Services) {
 $s = Get-Service -Name $svc -ErrorAction Stop
 if ($null -eq $s) {
 New-CheckResult -Category 'Service' -Item $svc -Status 'UNKNOWN' -Detail 'Required service unavailable'
 continue
 }
 $status = if ($s.Status -eq 'Running') { 'OK' } else { 'CRITICAL' }
 New-CheckResult -Category 'Service' -Item $s.DisplayName `
 -Status $status -Detail "Status: $($s.Status) | StartType: $($s.StartType)"
 }
}

function Get-CertificateHealthChecks {
 Write-Log "Checking certificate expiry..."
 $certs = Get-ChildItem -Path 'Cert:\LocalMachine\My' -ErrorAction Stop
 if (-not $certs) {
 New-CheckResult -Category 'Certificate' -Item 'LocalMachine\My' -Status 'INFO' -Detail 'No certificates found in personal store'
 return
 }
 foreach ($cert in $certs) {
 $daysLeft = ($cert.NotAfter - (Get-Date)).Days
 $subject = if ($cert.Subject) { $cert.Subject } else { $cert.Thumbprint }
 $status = if ($daysLeft -lt 0) { 'CRITICAL' }
 elseif ($daysLeft -lt $CertCriticalDays) { 'CRITICAL' }
 elseif ($daysLeft -lt $CertWarningDays) { 'WARNING' }
 else { 'OK' }
 New-CheckResult -Category 'Certificate' -Item $subject `
 -Status $status -Detail "Expires: $($cert.NotAfter.ToString('yyyy-MM-dd')) | $daysLeft days remaining | Thumbprint: $($cert.Thumbprint.Substring(0,12))..."
 }
}

function Get-ADReplicationHealthChecks {
 try {
  Import-Module ActiveDirectory -ErrorAction Stop
  $partners=@(Get-ADReplicationPartnerMetadata -Target $env:COMPUTERNAME -Scope Server -ErrorAction Stop)
  $failures=@(Get-ADReplicationFailure -Target $env:COMPUTERNAME -Scope Server -ErrorAction Stop)
  if ($partners.Count -eq 0) {
   New-CheckResult 'AD Replication' 'Local DC' 'UNKNOWN' 'No partners returned; verify single-DC topology or collection scope.'
  } elseif ($failures.Count -gt 0 -or @($partners | Where-Object LastReplicationResult -ne 0).Count -gt 0) {
   New-CheckResult 'AD Replication' 'Local DC' 'CRITICAL' 'Replication failures or nonzero partner results detected.'
  } else { New-CheckResult 'AD Replication' 'Local DC' 'OK' 'Partner metadata and failure collection succeeded; no errors returned.' }
 } catch { New-CheckResult 'AD Replication' 'Local DC' 'UNKNOWN' $_.Exception.Message }
}

function Get-DNSHealthChecks {
 Write-Log "Checking DNS health..."
 # Test local DNS resolution
 $testHosts = @($env:USERDNSDOMAIN)
 if (-not $env:USERDNSDOMAIN) { throw 'Domain DNS name unavailable.' }
 foreach ($h in $testHosts) {
 if (-not $h) { continue }
 try {
 $result = Resolve-DnsName -Name $h -ErrorAction Stop | Select-Object -First 1
 New-CheckResult -Category 'DNS' -Item "Resolve: $h" -Status 'OK' `
 -Detail "DNS answer returned for $h"
 } catch {
 New-CheckResult -Category 'DNS' -Item "Resolve: $h" -Status 'CRITICAL' -Detail $_.Exception.Message
 }
 }
}

function Get-SysvolNetlogonChecks {
 Write-Log "Checking SYSVOL and NETLOGON shares..."
 $shares = @('SYSVOL','NETLOGON')
 foreach ($share in $shares) {
 $path = "\\$env:COMPUTERNAME\$share"
 $exists = Test-Path -Path $path
 $status = if ($exists) { 'OK' } else { 'CRITICAL' }
 New-CheckResult -Category 'Shares' -Item $share `
 -Status $status -Detail "Path: $path | Accessible: $exists"
 }
}

function Get-DCConnectivityChecks {
 Write-Log "Checking Domain Controller connectivity..."
 try {
 Import-Module ActiveDirectory -ErrorAction Stop
 $dcs = @(Get-ADDomainController -Filter * -ErrorAction Stop | Select-Object -ExpandProperty HostName)
 if ($dcs.Count -eq 0) { throw 'No DCs retrieved.' }
 foreach ($dc in $dcs) {
 $ping = Test-Connection -ComputerName $dc -Count 1 -Quiet
 $ldap = Test-NetConnection -ComputerName $dc -Port 389 -InformationLevel Quiet -WarningAction SilentlyContinue
 $status = if ($ping -and $ldap) { 'OK' }
 elseif ($ping) { 'WARNING' }
 else { 'CRITICAL' }
 New-CheckResult -Category 'DC Connectivity' -Item $dc `
 -Status $status -Detail "Ping: $ping | LDAP(389): $ldap"
 }
 } catch {
 New-CheckResult -Category 'DC Connectivity' -Item 'ActiveDirectory Module' -Status 'UNKNOWN' `
 -Detail 'AD module unavailable or insufficient permissions'
 }
}

function Get-EventLogSummaryChecks {
 foreach ($log in @('System','Application')) {
  try {
   $events=@()
   try { $events=@(Get-WinEvent -FilterHashtable @{LogName=$log; Level=1,2,3; StartTime=(Get-Date).AddHours(-24)} -ErrorAction Stop) }
   catch { if ($_.FullyQualifiedErrorId -notlike 'NoMatchingEventsFound*') { throw } }
   $errors=@($events | Where-Object Level -in 1,2).Count
   $warnings=@($events | Where-Object Level -eq 3).Count
   $status=if ($errors -gt 10) {'CRITICAL'} elseif ($errors -gt 0 -or $warnings -gt 20) {'WARNING'} else {'OK'}
   New-CheckResult 'Event Logs' $log $status "Errors/critical: $errors; warnings: $warnings (24h)"
  } catch { New-CheckResult 'Event Logs' $log 'UNKNOWN' $_.Exception.Message }
 }
}

function Get-ADBackupStatusCheck {
 New-CheckResult 'AD Backup' 'Backup verification' 'UNKNOWN' 'Backup status is not implemented for the environment backup product. Verify its authoritative catalog and latest successful restore test.'
}

#endregion

#region ── HTML Report Builder ────────────────────────────────────────────────

function New-HtmlReport {
 param([object[]]$Results, [string]$ComputerName, [datetime]$RunTime)

 $ok = @($Results | Where-Object Status -eq 'OK').Count
 $warn = @($Results | Where-Object Status -eq 'WARNING').Count
 $crit = @($Results | Where-Object Status -eq 'CRITICAL').Count
 $info = @($Results | Where-Object Status -eq 'INFO').Count

 $unknown = @($Results | Where-Object Status -in 'UNKNOWN','ERROR').Count
 $overallStatus = if ($crit -gt 0) { 'CRITICAL' } elseif ($unknown -gt 0 -or $Results.Count -eq 0) { 'UNKNOWN' } elseif ($warn -gt 0) { 'WARNING' } else { 'OK' }
 $overallColor = switch ($overallStatus) {
 'CRITICAL' { '#e74c3c' }
 'UNKNOWN' { '#f39c12' }
 'WARNING' { '#f39c12' }
 default { '#27ae60' }
 }

 $statusBadge = @{
 'UNKNOWN' = '<span class="badge warning">UNKNOWN</span>'
 'ERROR' = '<span class="badge critical">ERROR</span>'
 'OK' = '<span class="badge ok">✔ OK</span>'
 'WARNING' = '<span class="badge warning">⚠ WARNING</span>'
 'CRITICAL' = '<span class="badge critical">✖ CRITICAL</span>'
 'INFO' = '<span class="badge info">ℹ INFO</span>'
 }

 $categories = $Results | Select-Object -ExpandProperty Category -Unique

 $tableRows = foreach ($cat in $categories) {
 $catResults = @($Results | Where-Object Category -eq $cat)
 $first = $true
 foreach ($r in $catResults) {
 $rowClass = $r.Status.ToLower()
 $catCell = if ($first) {
 "<td class='cat-cell' rowspan='$(($catResults).Count)'>$cat</td>"
 $first = $false
 } else { '' }
 "<tr class='$rowClass'>$catCell<td>$([Net.WebUtility]::HtmlEncode($r.Item))</td><td>$($statusBadge[$r.Status])</td><td>$([Net.WebUtility]::HtmlEncode($r.Detail))</td></tr>"
 }
 }

 $html = @"
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Environment Health Check - $ComputerName</title>
<style>
 :root {
 --bg: #0f1117; --surface: #1a1d27; --surface2: #22263a;
 --border: #2e3250; --text: #e2e8f0; --muted: #8892a4;
 --ok: #27ae60; --warn: #f39c12; --crit: #e74c3c; --info: #3498db;
 }
 * { box-sizing: border-box; margin: 0; padding: 0; }
 body { font-family: 'Segoe UI', Tahoma, sans-serif; background: var(--bg); color: var(--text); padding: 24px; }
 h1 { font-size: 1.6rem; font-weight: 700; letter-spacing: .5px; }
 h2 { font-size: 1rem; font-weight: 600; color: var(--muted); margin-bottom: 16px; }
 .header { display: flex; justify-content: space-between; align-items: flex-start;
 background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
 padding: 20px 28px; margin-bottom: 24px; }
 .overall { font-size: 1.4rem; font-weight: 800; color: $overallColor; }
 .meta { font-size: .82rem; color: var(--muted); margin-top: 6px; line-height: 1.7; }
 .summary { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 24px; }
 .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
 padding: 16px 20px; text-align: center; }
 .card .num { font-size: 2rem; font-weight: 800; }
 .card .lbl { font-size: .75rem; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); margin-top: 4px; }
 .card.ok .num { color: var(--ok); } .card.warn .num { color: var(--warn); }
 .card.crit .num { color: var(--crit); } .card.info .num { color: var(--info); }
 table { width: 100%; border-collapse: collapse; background: var(--surface);
 border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
 thead { background: var(--surface2); }
 th { padding: 12px 16px; text-align: left; font-size: .78rem; text-transform: uppercase;
 letter-spacing: .7px; color: var(--muted); border-bottom: 1px solid var(--border); }
 td { padding: 10px 16px; font-size: .85rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
 tr:last-child td { border-bottom: none; }
 tr.ok { border-left: 3px solid var(--ok); }
 tr.warning { border-left: 3px solid var(--warn); background: rgba(243,156,18,.04); }
 tr.critical { border-left: 3px solid var(--crit); background: rgba(231,76,60,.06); }
 tr.info { border-left: 3px solid var(--info); }
 .cat-cell { font-weight: 600; color: var(--muted); font-size: .8rem; text-transform: uppercase;
 letter-spacing: .5px; white-space: nowrap; }
 .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .75rem;
 font-weight: 700; letter-spacing: .4px; }
 .badge.ok { background: rgba(39,174,96,.15); color: var(--ok); }
 .badge.warning { background: rgba(243,156,18,.15); color: var(--warn); }
 .badge.critical { background: rgba(231,76,60,.15); color: var(--crit); }
 .badge.info { background: rgba(52,152,219,.15); color: var(--info); }
 .footer { margin-top: 20px; font-size: .75rem; color: var(--muted); text-align: center; }
</style>
</head>
<body>

<div class="header">
 <div>
 <h1>🖥️ Environment Health Check</h1>
 <div class="meta">
 Host: <strong>$ComputerName</strong> &nbsp;|&nbsp;
 Domain: <strong>$env:USERDNSDOMAIN</strong> &nbsp;|&nbsp;
 Run: <strong>$($RunTime.ToString('yyyy-MM-dd HH:mm:ss'))</strong>
 </div>
 </div>
 <div style="text-align:right">
 <div class="overall">$overallStatus</div>
 <div class="meta">Overall Status</div>
 </div>
</div>

<div class="summary">
 <div class="card ok"> <div class="num">$ok</div> <div class="lbl">Passed</div></div>
 <div class="card warn"> <div class="num">$warn</div> <div class="lbl">Warnings</div></div>
 <div class="card crit"> <div class="num">$crit</div> <div class="lbl">Critical</div></div>
 <div class="card info"> <div class="num">$info</div> <div class="lbl">Info (unknown: $unknown)</div></div>
</div>

<table>
 <thead>
 <tr><th>Category</th><th>Item</th><th>Status</th><th>Detail</th></tr>
 </thead>
 <tbody>
 $($tableRows -join "`n ")
 </tbody>
</table>

<div class="footer">Generated by Get-EnvironmentHealthCheck.ps1 &mdash; powershell-admin-toolkit &mdash; $($RunTime.Year)</div>
</body>
</html>
"@
 return $html
}

#endregion

#region ── Main Execution ─────────────────────────────────────────────────────

$runTime = Get-Date
$hostName = $env:COMPUTERNAME
$reportFile = Join-Path $OutputPath "HealthCheck_${hostName}_$($runTime.ToString('yyyyMMdd_HHmmss')).html"

Write-Log "=== Environment Health Check Starting on $hostName ===" 'INFO'

$allResults = @()
foreach ($check in @('Get-DiskHealthChecks','Get-ServiceHealthChecks','Get-CertificateHealthChecks','Get-ADReplicationHealthChecks','Get-DNSHealthChecks','Get-SysvolNetlogonChecks','Get-DCConnectivityChecks','Get-EventLogSummaryChecks','Get-ADBackupStatusCheck')) {
 try {
  $result=@(& $check)
  if ($result.Count -eq 0) { throw 'Check returned no results.' }
  $allResults += $result
 } catch { $allResults += New-CheckResult 'Collection' $check 'UNKNOWN' $_.Exception.Message }
}

# Console summary
$allResults | Format-Table -AutoSize

# HTML report
Write-Log "Generating HTML report: $reportFile"
$html = New-HtmlReport -Results $allResults -ComputerName $hostName -RunTime $runTime
$html | Out-File -FilePath $reportFile -Encoding UTF8
Write-Log "Report saved: $reportFile" 'OK'

# Optional email
if ($SendEmail) {
 if (-not $SmtpServer -or -not $EmailFrom -or -not $EmailTo) {
 Write-Log "SendEmail specified but SmtpServer, EmailFrom, or EmailTo missing. Skipping." 'WARN'
 } else {
 $subject = "[$((($allResults | Where-Object Status -in 'CRITICAL','WARNING','UNKNOWN','ERROR') | Measure-Object).Count) Issues] Health Check - $hostName - $($runTime.ToString('yyyy-MM-dd'))"
 Send-MailMessage -From $EmailFrom -To $EmailTo -Subject $subject `
 -Body $html -BodyAsHtml -SmtpServer $SmtpServer -Encoding UTF8
 Write-Log "Report emailed to: $($EmailTo -join ', ')" 'OK'
 }
}

Write-Log "=== Health Check Complete ===" 'OK'
return $allResults

#endregion
