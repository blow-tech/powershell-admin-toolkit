#Requires -Version 5.1
<#
.SYNOPSIS
Read replicated, approximate AD logon timestamps; not exact last authentication.
.DESCRIPTION
LastLogonDate derives from lastLogonTimestamp and can lag. A missing value is
UNKNOWN, not proof of never logging on. Do not use this alone to disable accounts.
For exact AD lastLogon, separately query every relevant DC and account for failures.
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$Server,
    [string]$SearchBase,
    [string]$OutputFile,
    [switch]$IncludeDisabled
)
$ErrorActionPreference='Stop'
function ConvertTo-LogonObservation {
    param($User,[datetime]$Now=(Get-Date))
    [pscustomobject]@{
        DisplayName=$User.DisplayName; SamAccountName=$User.SamAccountName; Enabled=$User.Enabled
        LastLogonDate=$User.LastLogonDate
        DaysSinceLogon=if ($null -ne $User.LastLogonDate) { [math]::Floor(($Now-$User.LastLogonDate).TotalDays) } else {$null}
        TimestampStatus=if ($null -ne $User.LastLogonDate) {'ApproximateReplicated'} else {'UNKNOWN'}
        DistinguishedName=$User.DistinguishedName
    }
}
if ($MyInvocation.InvocationName -ne '.') {
    Import-Module ActiveDirectory -ErrorAction Stop
    $query=@{Server=$Server;Filter='Enabled -eq $true';Properties=@('DisplayName','LastLogonDate');ErrorAction='Stop'}
    if ($IncludeDisabled) {$query.Filter='*'}
    if ($SearchBase) {$query.SearchBase=$SearchBase}
    $now=Get-Date
    $results=@(Get-ADUser @query | ForEach-Object {ConvertTo-LogonObservation $_ $now} | Sort-Object LastLogonDate -Descending)
    if ($OutputFile) {$results | Export-Csv -LiteralPath $OutputFile -NoTypeInformation -Encoding UTF8 -NoClobber -ErrorAction Stop}
    $results
}
