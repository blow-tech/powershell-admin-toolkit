#Requires -Version 5.1
<#
.SYNOPSIS
Preview expiring AD user accounts in an explicit server/OU scope.
.DESCRIPTION
Returns report objects by default. Mail requires -Send, an approved SMTP endpoint,
explicit addresses and ShouldProcess approval. This is account expiry, not password expiry.
Manager lookup failure is UNKNOWN. No directory or scheduled-task changes.
#>
[CmdletBinding(SupportsShouldProcess,ConfirmImpact='High')]
param(
    [Parameter(Mandatory)][string]$Server,
    [Parameter(Mandatory)][string]$SearchBase,
    [Alias('ExpirationDays')][ValidateRange(1,365)][int]$Days=10,
    [switch]$Send,
    [string]$EmailFrom,
    [string]$EmailTo,
    [string]$EmailSMTPServer,
    [ValidateRange(1,65535)][int]$SmtpPort=587,
    [switch]$UseSsl,
    [pscredential]$Credential
)
$ErrorActionPreference='Stop'
if ($Send -and (-not $EmailFrom -or -not $EmailTo -or -not $EmailSMTPServer)) {throw 'Sending requires explicit SMTP/from/to configuration.'}
if ($Send) {
    $null=New-Object Net.Mail.MailAddress($EmailFrom)
    $null=New-Object Net.Mail.MailAddress($EmailTo)
}
Import-Module ActiveDirectory -ErrorAction Stop
$managers=@{}
$accounts=@(Search-ADAccount -AccountExpiring -UsersOnly -Server $Server -SearchBase $SearchBase -TimeSpan ([timespan]::FromDays($Days)) -ErrorAction Stop | ForEach-Object {
    $user=Get-ADUser -Identity $_.DistinguishedName -Server $Server -Properties Manager,AccountExpirationDate -ErrorAction Stop
    $manager=$null; $state='NotAssigned'
    if ($user.Manager) {
        if (-not $managers.ContainsKey($user.Manager)) {
            try {$managers[$user.Manager]=[pscustomobject]@{Name=(Get-ADUser -Identity $user.Manager -Server $Server -ErrorAction Stop).Name;State='Collected'}}
            catch {$managers[$user.Manager]=[pscustomobject]@{Name=$null;State='UNKNOWN'}}
        }
        $manager=$managers[$user.Manager].Name; $state=$managers[$user.Manager].State
    }
    [pscustomobject]@{Name=$user.Name;SamAccountName=$user.SamAccountName;AccountExpirationDate=$user.AccountExpirationDate;Manager=$manager;ManagerState=$state;DistinguishedName=$user.DistinguishedName}
})
$accounts
if ($Send -and $PSCmdlet.ShouldProcess($EmailTo,'Send account-expiry report via configured SMTP relay')) {
    $options=@{SmtpServer=$EmailSMTPServer;Port=$SmtpPort;UseSsl=[bool]$UseSsl;From=$EmailFrom;To=$EmailTo
        Subject="AD account expiry: next $Days days";Body=($accounts | ConvertTo-Html | Out-String);BodyAsHtml=$true;Encoding='UTF8';ErrorAction='Stop'}
    if ($Credential) {$options.Credential=$Credential}
    Send-MailMessage @options
}
