#Requires -Version 5.1
<#
.SYNOPSIS
Bounded Security log observations for computers in an explicit AD OU.
.DESCRIPTION
Collects successful logon (4624), logoff (4634), user-initiated logoff (4647)
and explicit-credential attempt (4648). Named XML fields avoid language-dependent
message parsing. UNKNOWN/TRUNCATED computer results remain visible and fail the run.
Audit policy, event retention and permissions must be validated separately.
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory)][string]$Server,
    [Parameter(Mandatory)][string]$SearchBase,
    [string]$OutputFile,
    [ValidateRange(1,30)][int]$DaysBack=1,
    [ValidateRange(1,100000)][int]$MaxEventsPerComputer=10000
)
$ErrorActionPreference='Stop'
function ConvertFrom-LogonAuditEvent {
    param($Event)
    $labels=@{4624='SuccessfulLogon';4634='Logoff';4647='UserInitiatedLogoff';4648='ExplicitCredentialAttempt'}
    if (-not $labels.ContainsKey([int]$Event.Id)) {throw 'Unsupported event ID'}
    $data=@{}
    foreach ($field in ([xml]$Event.ToXml()).Event.EventData.Data) {$data[[string]$field.Name]=[string]$field.InnerText}
    $account=if ($Event.Id -eq 4647) {$data.SubjectUserName} else {$data.TargetUserName}
    if ([string]::IsNullOrWhiteSpace($account)) {throw 'Required named account field is missing'}
    [pscustomobject]@{
        ComputerName=$Event.MachineName;Event=$labels[[int]$Event.Id];EventId=$Event.Id
        Time=$Event.TimeCreated;RecordId=$Event.RecordId;Account=$account
        LogonType=$data.LogonType;Status='Collected';Detail=$null
    }
}
function Get-ComputerLogonEvidence {
    param([string]$Computer,[datetime]$StartTime,[int]$MaxEvents=10000)
    $ErrorActionPreference='Stop'
    try {
        $events=@()
        try {$events=@(Get-WinEvent -ComputerName $Computer -FilterHashtable @{
            LogName='Security';Id=4624,4634,4647,4648;StartTime=$StartTime
        } -MaxEvents $MaxEvents -ErrorAction Stop)}
        catch {if ($_.FullyQualifiedErrorId -notlike 'NoMatchingEventsFound*') {throw}}
        $rows=@(foreach ($event in $events) {ConvertFrom-LogonAuditEvent $event})
        $rows
        if (-not $events.Count -or $events.Count -ge $MaxEvents) {
            [pscustomobject]@{ComputerName=$Computer;Event=$null;EventId=$null;Time=$null;RecordId=$null;Account=$null;LogonType=$null
                Status=if ($events.Count -ge $MaxEvents) {'TRUNCATED'} else {'NoMatchingEvents'}
                Detail="Time-window query returned $($events.Count) events; audit policy and retention are separate prerequisites."}
        }
    } catch {
        [pscustomobject]@{ComputerName=$Computer;Event=$null;EventId=$null;Time=$null;RecordId=$null;Account=$null;LogonType=$null;Status='UNKNOWN';Detail=$_.Exception.Message}
    }
}
Import-Module ActiveDirectory -ErrorAction Stop
$computers=@(Get-ADComputer -Server $Server -SearchBase $SearchBase -Filter 'Enabled -eq $true' -Properties DNSHostName -ErrorAction Stop)
if (-not $computers.Count) {throw 'No computers resolved; scope coverage is UNKNOWN.'}
$start=(Get-Date).AddDays(-$DaysBack)
$results=@(foreach ($computer in $computers) {
    if ([string]::IsNullOrWhiteSpace($computer.DNSHostName)) {throw 'Computer has no DNSHostName; resolve scope before collection.'}
    Get-ComputerLogonEvidence $computer.DNSHostName $start $MaxEventsPerComputer
})
if ($OutputFile) {$results | Export-Csv -LiteralPath $OutputFile -NoTypeInformation -Encoding UTF8 -NoClobber -ErrorAction Stop}
$results
if (@($results | Where-Object {$_.Status -in 'UNKNOWN','TRUNCATED'}).Count) {throw 'Logon evidence is incomplete; inspect UNKNOWN/TRUNCATED rows.'}
