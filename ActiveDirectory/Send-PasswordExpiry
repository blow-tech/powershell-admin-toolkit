#Requires -Modules ActiveDirectory

<#
.SYNOPSIS
    Sends password expiry notification emails to users and a summary to the helpdesk.

.DESCRIPTION
    Queries Active Directory for enabled user accounts with expiring or expired passwords.
    Sends reminder emails at 14, 7, 3, and 1 days before expiry, plus a final notice on
    the day of expiry. A summary report is emailed to the Helpdesk/IT Admin team.

    Designed to be scheduled daily via Windows Task Scheduler.

.EXAMPLE
    .\UserPasswordExpiryNotificationEmails.ps1

.NOTES
    Edit the CONFIG: sections below before first run.
    FIX: Corrected subject line typo "expried" → "expired"
    Author:  blow-tech
    Version: 2.1
#>

Import-Module ActiveDirectory -ErrorAction Stop

# ══════════════════════════════════════════════════════════
#  CONFIG: Edit these values to match your environment
# ══════════════════════════════════════════════════════════
$smtpServer      = "email.domain.com"         # CONFIG: Your SMTP server
$helpdeskEmail   = "helpdesk@domain.com"      # CONFIG: Helpdesk/IT Admin email
$emailFromAddr   = "helpdesk@domain.com"      # CONFIG: Sender address
$userEmailDomain = "domain.com"               # CONFIG: User email domain (for $samname@domain.com)
$notifyDays      = @(14, 7, 3, 1, 0)          # CONFIG: Days before expiry to notify
# ══════════════════════════════════════════════════════════

# ── Get Domain Password Policy ─────────────────────────────────────────────────
try {
    $maxDays = (Get-ADDefaultDomainPasswordPolicy -ErrorAction Stop).MaxPasswordAge.TotalDays
}
catch {
    Write-Error "[!] Could not retrieve domain password policy: $_"
    exit 1
}

$summaryBody    = "Name`tExpire Date`tDays To Expire`n"
$thereAreExpiring = $false
$smtp           = New-Object Net.Mail.SmtpClient($smtpServer)

# ── Process Users ──────────────────────────────────────────────────────────────
$adFilter = {
    (mail -like "*@*") -and
    (Enabled -eq $true) -and
    (PasswordNeverExpires -eq $false)
}

$users = Get-ADUser -Filter $adFilter -Properties GivenName, SamAccountName, pwdLastSet, mail |
         Sort-Object pwdLastSet

foreach ($user in $users) {

    # Skip accounts where pwdLastSet is 0 (must change at next logon)
    if ($user.pwdLastSet -eq 0) { continue }

    $lastSet      = [System.DateTime]::FromFileTimeUtc($user.pwdLastSet)
    $expiryDate   = $lastSet.AddDays($maxDays)
    $daysToExpire = [math]::Round((New-TimeSpan -Start (Get-Date) -End $expiryDate).TotalDays)
    $samName      = $user.SamAccountName
    $firstName    = $user.GivenName
    $emailTo      = "$samName@$userEmailDomain"

    if ($daysToExpire -in $notifyDays) {
        $thereAreExpiring = $true

        # ── Build user email ────────────────────────────────────────────────
        if ($daysToExpire -eq 0) {
            $subject = "$firstName, your password has expired!"   # FIX: was "expried"
            $body    = @"
$firstName,

Your password has expired and you must change it immediately.
No further email notifications will be sent.

Contact the IT Helpdesk for assistance.
"@
        }
        else {
            $subject = "$firstName, your password expires in $daysToExpire day(s)!"
            $body    = @"
$firstName,

Your password expires in $daysToExpire day(s).

To change your password:
  - Windows: Press Ctrl + Alt + Del, then click 'Change a password'
  - Mac: Follow the instructions at http://intranet/it/password-change

If you need assistance, contact the IT Helpdesk.
"@
        }

        # ── Send user email ─────────────────────────────────────────────────
        try {
            $smtp.Send($emailFromAddr, $emailTo, $subject, $body)
            Write-Host "[+] Notified: $samName ($daysToExpire days)" -ForegroundColor Green
        }
        catch {
            Write-Warning "[!] Failed to send email to $emailTo : $_"
        }

        $summaryBody += "$samName`t$($expiryDate.ToShortDateString())`t$daysToExpire`n"
    }
    elseif ($daysToExpire -lt 0) {
        # Already expired — add to report but don't re-notify user
        $thereAreExpiring = $true
        $summaryBody += "$samName`t$($expiryDate.ToShortDateString())`t$daysToExpire (EXPIRED)`n"
    }
}

# ── Send Helpdesk Summary ──────────────────────────────────────────────────────
if ($thereAreExpiring) {
    try {
        $summarySubject = "Daily Password Expiry Report - $(Get-Date -Format 'yyyy-MM-dd')"
        $smtp.Send($emailFromAddr, $helpdeskEmail, $summarySubject, $summaryBody)
        Write-Host "[+] Summary report sent to $helpdeskEmail" -ForegroundColor Cyan
    }
    catch {
        Write-Warning "[!] Failed to send summary report to helpdesk: $_"
    }
}
else {
    Write-Host "[i] No expiring passwords found today. No emails sent." -ForegroundColor Gray
}
