#Requires -Version 5.1
<#
Default: preview directory-derived recipients and per-user computed password expiry.
-Send requires explicit SMTP/from settings and an existing protected StateDirectory.
Uses a per-run lock and sent markers to suppress same-day reruns. SMTP cannot guarantee
exactly-once delivery if interrupted after acceptance but before marker publication.
No synthesized recipient addresses or default-domain password-age assumptions.
#>
[CmdletBinding(SupportsShouldProcess, ConfirmImpact='High')]
param(
    [Parameter(Mandatory)][string]$Server,
    [int[]]$NotifyDays=@(14,7,3,1,0),
    [switch]$Send,
    [string]$SmtpServer,
    [ValidateRange(1,65535)][int]$SmtpPort=25,
    [switch]$UseSsl,
    [string]$From,
    [string]$StateDirectory
)
$ErrorActionPreference='Stop'
function Get-PasswordExpiryPlan {
    param($User,[datetime]$NowUtc,[int[]]$NotifyDays)
    $expiryValue=$User.'msDS-UserPasswordExpiryTimeComputed'
    if ($User.PasswordNeverExpires -or $User.pwdLastSet -eq 0 -or $null -eq $expiryValue) { return }
    $fileTime=[long]$expiryValue
    if ($fileTime -le 0 -or $fileTime -eq [long]::MaxValue) { return }
    $expiry=[datetime]::FromFileTimeUtc($fileTime)
    $days=[int][math]::Ceiling(($expiry-$NowUtc).TotalDays)
    if ($days -notin $NotifyDays) { return }
    if ([string]::IsNullOrWhiteSpace($User.mail)) { throw "No directory mail address for $($User.ObjectGUID)" }
    $address=[Net.Mail.MailAddress]::new($User.mail)
    if ($address.Address -ne $User.mail -or $address.Address -notmatch '^[^\s@]+@[^\s@]+\.[^\s@]+$') { throw 'Invalid directory mail address.' }
    [pscustomobject]@{ UserId=[string]$User.ObjectGUID; Recipient=$address.Address; ExpiryUtc=$expiry; DaysUntilExpiry=$days; Expired=($expiry -le $NowUtc) }
}
Import-Module ActiveDirectory -ErrorAction Stop
$users=@(Get-ADUser -Server $Server -Filter {Enabled -eq $true -and PasswordNeverExpires -eq $false} -Properties mail,pwdLastSet,PasswordNeverExpires,'msDS-UserPasswordExpiryTimeComputed' -ErrorAction Stop)
$now=[datetime]::UtcNow
$plan=@($users | ForEach-Object { Get-PasswordExpiryPlan $_ $now $NotifyDays })
if (-not $Send) { $plan; return }
if (-not $SmtpServer -or -not $From -or -not $StateDirectory) { throw '-Send requires SmtpServer, From and StateDirectory.' }
$null=[Net.Mail.MailAddress]::new($From)
$state=Get-Item -LiteralPath $StateDirectory -Force
if (-not $state.PSIsContainer -or $state.PSProvider.Name -ne 'FileSystem') { throw 'StateDirectory must be an existing protected directory.' }
for ($ancestor=$state; $null -ne $ancestor; $ancestor=$ancestor.Parent) {
    if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse state paths refused.' }
}
$lock=$null; $smtp=$null
try {
    if (-not $WhatIfPreference) {
        $lockPath=Join-Path $state.FullName 'password-expiry.lock'
        if (Test-Path -LiteralPath $lockPath) {
            if ((Get-Item -LiteralPath $lockPath -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse lock path refused.' }
        }
        $lock=[IO.File]::Open($lockPath,[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)
        $smtp=[Net.Mail.SmtpClient]::new($SmtpServer,$SmtpPort)
        $smtp.EnableSsl=[bool]$UseSsl
        $smtp.Timeout=30000
    }
    foreach ($item in $plan) {
        $marker=Join-Path $state.FullName ("$($item.UserId)-$($item.ExpiryUtc.Ticks)-$($now.ToString('yyyyMMdd')).sent")
        if (Test-Path -LiteralPath $marker) { continue }
        if ($PSCmdlet.ShouldProcess($item.Recipient,"Send password expiry notice for directory object $($item.UserId)")) {
            $subject=if ($item.Expired) {'Your password has expired'} else {"Your password expires in $($item.DaysUntilExpiry) day(s)"}
            $body="Password expiry (UTC): $($item.ExpiryUtc.ToString('u')). Contact your IT helpdesk if you need assistance."
            $smtp.Send($From,$item.Recipient,$subject,$body)
            [IO.File]::WriteAllText($marker,([datetime]::UtcNow.ToString('o')))
            $item
        }
    }
} finally {
    if ($null -ne $smtp) { $smtp.Dispose() }
    if ($null -ne $lock) { $lock.Dispose() }
}
