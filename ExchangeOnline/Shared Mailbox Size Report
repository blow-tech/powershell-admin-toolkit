# Read-only shared mailbox statistics; original concept AdminDroid / o365reports.com.
# ExchangeOnlineManagement V3, read-only recipient/statistics RBAC. Existing session only.
[CmdletBinding()]
param([Parameter(Mandatory=$true)][guid]$TenantId,
 [Parameter(Mandatory=$true)][string]$OutputPath,[string[]]$Identity)
$ErrorActionPreference='Stop'
. (Join-Path $PSScriptRoot '../scripts/common/ReportSafety.ps1')
Assert-ExchangeTenant $TenantId
$boxes=@(if($Identity){foreach($id in ($Identity | Select-Object -Unique)){Get-EXOMailbox -Identity $id -ErrorAction Stop}}else{Get-EXOMailbox -RecipientTypeDetails SharedMailbox -ResultSize Unlimited -ErrorAction Stop})
if(@($boxes | Where-Object RecipientTypeDetails -ne 'SharedMailbox').Count){throw 'Explicit scope contains a non-shared mailbox.'}
$rows=@(foreach($box in $boxes){
 $stats=@(Get-EXOMailboxStatistics -Identity $box.PrimarySmtpAddress -ErrorAction Stop)
 if($stats.Count -ne 1){throw 'Expected exactly one statistics result per mailbox.'}
 [pscustomobject]@{Identity=$box.PrimarySmtpAddress;DisplayName=$box.DisplayName;ItemCount=$stats[0].ItemCount;TotalItemSizeRaw=[string]$stats[0].TotalItemSize;DeletedItemCount=$stats[0].DeletedItemCount;TotalDeletedItemSizeRaw=[string]$stats[0].TotalDeletedItemSize;ByteConversion='NotAssessed';Scope='Primary mailbox only'}
})
Export-NewReport $rows $OutputPath
[pscustomobject]@{Path=$OutputPath;Rows=$rows.Count}
