# Read-only V2 trace evidence; original concept AdminDroid / o365reports.com.
# Requires ExchangeOnlineManagement >=3.7.0, Message Tracking RBAC, existing tenant session.
# A general trace can omit messages with >1000 recipients: use MessageTraceId for those messages.
[CmdletBinding()]
param([Parameter(Mandatory=$true)][guid]$TenantId,
 [Parameter(Mandatory=$true)][datetimeoffset]$StartDate,
 [Parameter(Mandatory=$true)][datetimeoffset]$EndDate,
 [Parameter(Mandatory=$true)][string]$OutputPath,
 [string]$SenderAddress,[string]$RecipientAddress,[string]$ExternalDomainName,
 [ValidateSet('Delivered','Failed','GettingStatus','FilteredAsSpam','Quarantined')][string]$MailStatus,
 [guid]$MessageTraceId,
 [ValidateRange(1,1000000)][int]$MaxRecords=100000)
$ErrorActionPreference='Stop'
function Get-TraceEvidence {
 param([datetime]$StartUtc,[datetime]$EndUtc,[hashtable]$Filters,[int]$Limit)
 $rows=New-Object 'System.Collections.Generic.List[object]';$seen=@{};$cursors=@{};$end=$EndUtc;$recipient=$null
 while($true){
  $query=@{StartDate=$StartUtc;EndDate=$end;ResultSize=5000;ErrorAction='Stop'}
  foreach($key in $Filters.Keys){$query[$key]=$Filters[$key]}
  if($recipient){$query.StartingRecipientAddress=$recipient}
  # Stay below the documented 100 queries/5min tenant ceiling for this process.
  Start-Sleep -Seconds 4
  $batch=@(Get-MessageTraceV2 @query)
  if(-not $batch.Count){break}
  $added=0
  foreach($item in $batch){
   if(-not $item.MessageTraceId -or -not $item.RecipientAddress -or -not $item.Received){throw 'Malformed trace result.'}
   # EXO documents Received as UTC, including DateTime values without a Kind.
   $time=[datetime]::SpecifyKind([datetime]$item.Received,[DateTimeKind]::Utc)
   $key=([string]$item.MessageTraceId)+'|'+([string]$item.RecipientAddress).ToLowerInvariant()+'|'+$time.Ticks
   if(-not $seen.ContainsKey($key)){
    $seen[$key]=$true;$added++
    if($time -ge $StartUtc -and $time -lt $EndUtc){$rows.Add($item)}
    if($seen.Count -gt $Limit){throw 'Trace record budget exceeded. Narrow the interval; no report published.'}
   }
  }
  $last=$batch[-1];$end=[datetime]::SpecifyKind([datetime]$last.Received,[DateTimeKind]::Utc);$recipient=[string]$last.RecipientAddress
  $cursor=$end.Ticks.ToString()+'|'+$recipient.ToLowerInvariant()
  if(-not $added -or $cursors.ContainsKey($cursor)){throw 'Trace cursor repeated or made no progress. No report published.'}
  $cursors[$cursor]=$true
  # Continue even after a short batch; a short response is not completeness evidence.
 }
 $rows.ToArray()
}
if($StartDate -ge $EndDate -or ($EndDate-$StartDate).TotalDays -gt 10 -or $StartDate -lt [datetimeoffset]::UtcNow.AddDays(-90) -or $EndDate -gt [datetimeoffset]::UtcNow){throw 'Require an explicit interval of at most 10 days within the last 90 days, ending no later than now.'}
. (Join-Path $PSScriptRoot '../scripts/common/ReportSafety.ps1')
Assert-ExchangeTenant $TenantId
$internal=@(Get-AcceptedDomain -ErrorAction Stop | ForEach-Object {$_.DomainName.ToString().ToLowerInvariant()})
if(-not $internal.Count -or @($internal | Where-Object {$_ -match '\*'}).Count){throw 'Accepted domain scope is missing or contains wildcards requiring explicit review.'}
$filters=@{}
if($SenderAddress){$filters.SenderAddress=$SenderAddress};if($RecipientAddress){$filters.RecipientAddress=$RecipientAddress}
if($MailStatus){$filters.Status=$MailStatus};if($MessageTraceId -ne [guid]::Empty){$filters.MessageTraceId=$MessageTraceId}
$all=@(Get-TraceEvidence $StartDate.UtcDateTime $EndDate.UtcDateTime $filters $MaxRecords)
$rows=@($all | Where-Object {
 $sender=([string]$_.SenderAddress -split '@')[-1];$recipient=([string]$_.RecipientAddress -split '@')[-1]
 ($internal -contains $sender) -and ($internal -notcontains $recipient) -and (-not $ExternalDomainName -or $recipient -eq $ExternalDomainName)
} | Select-Object MessageTraceId,Received,SenderAddress,RecipientAddress,Subject,Status,FromIP,ToIP,Size)
Export-NewReport $rows $OutputPath
[pscustomobject]@{Path=$OutputPath;Rows=$rows.Count;Scope='Service-returned trace evidence only; high-recipient messages require MessageTraceId, retention/ingestion not assessed'}
