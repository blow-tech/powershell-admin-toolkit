<# Read-only direct static distribution-group membership. Requires an existing EXO V3
session in TenantId and recipient read permissions. Dynamic/nested/effective membership is not assessed.
No auto-connect, install, disconnect, or output overwrite. A denied query aborts publication. #>
[CmdletBinding()]
param([Parameter(Mandatory)][guid]$TenantId,[Parameter(Mandatory)][string]$OutputPath)
$ErrorActionPreference='Stop'
. (Join-Path (Split-Path $PSScriptRoot -Parent) 'scripts/common/ReportSafety.ps1')
Assert-ExchangeTenant $TenantId
$rows=New-Object 'System.Collections.Generic.List[object]'
foreach($group in @(Get-DistributionGroup -ResultSize Unlimited -ErrorAction Stop)) {
 if(-not $group.Guid){throw 'Distribution group lacks immutable GUID.'}
 $members=@(Get-DistributionGroupMember -Identity $group.Guid -ResultSize Unlimited -ErrorAction Stop)
 if(-not $members.Count){$rows.Add([pscustomobject]@{GroupGuid=$group.Guid;GroupEmail=$group.PrimarySmtpAddress;MemberGuid='';MemberEmail='';MemberType='';MemberCount=0;CollectionState='Empty'})}
 foreach($member in $members){$rows.Add([pscustomobject]@{GroupGuid=$group.Guid;GroupEmail=$group.PrimarySmtpAddress;MemberGuid=$member.Guid;MemberEmail=$member.PrimarySmtpAddress;MemberType=$member.RecipientType;MemberCount=$members.Count;CollectionState='Collected'})}
}
Export-NewReport -Rows $rows.ToArray() -Path $OutputPath
[pscustomobject]@{Path=$OutputPath;Rows=$rows.Count;Scope='Direct static membership only'}
